<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    package="com.keldurn.browser">

    <!-- Permiso fundamental para acceder al servidor del juego -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_custom"
        android:label="Keldurn Web"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        
        <!-- screenOrientation fuerza el modo panorámico y configChanges evita reinicios de la app al girar -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
